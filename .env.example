# Supabase (required)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (required)
RESEND_API_KEY=
RESEND_FROM=FossilUI <noreply@tronzlabs.com>

# Public site URL (used for CORS)
PUBLIC_BASE_URL=https://fossilui.buzz

# Media served from Supabase Storage (public bucket). Unset = load from /public.
VITE_MEDIA_URL=https://nldfscykuoyufonuskik.supabase.co/storage/v1/object/public/media-fossilui
# Optional override for the image in contact emails
# EMAIL_IMAGE_URL=

# Supabase Storage S3 upload credentials (local only — never VITE_-prefixed, never on Vercel)
# SUPABASE_S3_ENDPOINT=https://nldfscykuoyufonuskik.supabase.co/storage/v1/s3
# SUPABASE_S3_REGION=ap-northeast-1
# SUPABASE_S3_BUCKET=media-fossilui
# SUPABASE_S3_ACCESS_KEY_ID=
# SUPABASE_S3_SECRET_ACCESS_KEY=

# Optional comma-separated extra CORS origins
# ALLOWED_ORIGINS=https://preview.example.com

# Upstash Redis — IP + email rate limiting (recommended for production)
# In Upstash console: open your database → "REST API" tab (not the redis:// CLI URL)
UPSTASH_REDIS_REST_URL=https://your-database-name.upstash.io
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile — bot protection (recommended for production)
# Dashboard: https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SECRET_KEY=
# Site key — set on Vercel (runtime via /api/contact-config). VITE_ is optional for local Vite.
TURNSTILE_SITE_KEY=
VITE_TURNSTILE_SITE_KEY=

# Local dev: Cloudflare test keys (always pass verification)
# VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
